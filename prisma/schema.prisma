generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── SELF CARE: DIET ─────────────────────────────────────────────────────────

/// A meal ticked off on the diet plan. The plan itself is in the repo (lib/meal-plans/), so a tick
/// names its meal by the row's label ("Lunch"; "home:Lunch" for the at-home day), unique in a day.
model MealCheck {
  /// Local calendar date, as everywhere else that counts by the day.
  date      DateTime @db.Date
  meal      String
  createdAt DateTime @default(now())

  @@id([date, meal])
}

/// Water drunk, one row each time some is logged. A day's total is their sum.
model WaterIntake {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  ml        Int
  createdAt DateTime @default(now())

  @@index([date])
}

// ─── FINANCES ────────────────────────────────────────────────────────────────

model FinanceConfig {
  id            String   @id @default("global")
  monthlyBudget Float    @default(0)
  updatedAt     DateTime @updatedAt
}

model Expense {
  id          String          @id @default(cuid())
  // Supplied by the offline queue. Unique, so a POST replayed by a concurrent sync,
  // a second tab, or a retry after a lost response can never insert the same expense
  // twice. Nullable because rows created before this existed have none, and Postgres
  // permits many NULLs in a unique index.
  clientId    String?         @unique
  year        Int
  month       Int
  category    ExpenseCategory
  amount      Float
  description String?
  // Which pot paid: the monthly budget or additional income — which card to use.
  source      FundSource      @default(BASE)
  createdAt   DateTime        @default(now())

  @@index([year, month, createdAt(sort: Desc)])
}

model AdditionalIncome {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  amount      Float
  description String?
  createdAt   DateTime @default(now())

  @@index([year, month, createdAt(sort: Desc)])
}

enum ExpenseCategory {
  FOOD
  BOOKS
  EDUCATION
  ENTERTAINMENT
  CLOTHING
  SUBSCRIPTIONS
  SELF_CARE
  TRANSPORTATION
  OTHER
  CASH
}

model Subscription {
  id             String     @id @default(cuid())
  name           String
  amount         Float
  startYear      Int
  startMonth     Int
  cancelledYear  Int?
  cancelledMonth Int?
  source         FundSource @default(BASE)
  createdAt      DateTime   @default(now())
}

// A purchase paid in a fixed number of monthly installments (taksit) — a subscription that ends by
// itself. The price is stored; each month's share is derived (lib/installments.ts), to the kuruş,
// so the installments always add up to it.
model Installment {
  id         String     @id @default(cuid())
  name       String
  total      Float
  // How many monthly installments, the first in startYear/startMonth.
  count      Int
  startYear  Int
  startMonth Int
  source     FundSource @default(BASE)
  createdAt  DateTime   @default(now())
}

// The two pots money is spent from, like two cards: the monthly budget, and additional income.
enum FundSource {
  BASE
  EXTRA
}

// ─── SHOPPING ────────────────────────────────────────────────────────────────

// A shop you have tried, filed by category, with what you liked and what you didn't.
model Shop {
  id        String        @id @default(cuid())
  name      String
  url       String
  // Free text, so any category can be made; typing an existing one in another case files with it.
  category  String
  liked     String?
  disliked  String?
  products  ShopProduct[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([category])
}

// Something bought (or looked at) from a shop, with what you thought of that thing in particular.
model ShopProduct {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

// ─── SERIES ──────────────────────────────────────────────────────────────────

// ─── SHARED ENUMS ────────────────────────────────────────────────────────────

// ── Calendar ─────────────────────────────────────────────────────────────────
// Day plans are dealt onto real dates. A date's kind (school or holiday) is always DERIVED
// from the terms, days off and the weekend rule — never stored — because terms get edited and
// a stored kind would quietly disagree with the calendar afterwards.

/// A thing you study. No hours and no place in a day — you pick one when you start a session,
/// and the session pays XP to the stats it trains.
model Module {
  id                String         @id @default(cuid())
  title             String         @unique
  notes             String?
  /// The stats this module trains, 1-3 of them. The API enforces the range; a module with none
  /// could never pay anything.
  stats             Stat[]
  /// Hours a week you mean to spend on it, stored in minutes so 7.5h is exact. Null means no goal.
  weeklyGoalMinutes Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          StudySession[]

  @@index([title])
}

// ─── TASKS & STATS ───────────────────────────────────────────────────────────

model XpAward {
  id             String       @id @default(cuid())
  studySessionId String
  studySession   StudySession @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  stat           Stat
  amount         Int
  createdAt      DateTime     @default(now())

  // Paying the same session twice is the one thing that must never happen.
  @@unique([studySessionId, stat])
  @@index([stat])
}

/// Study settings that are not about any one module. A single row, like FinanceConfig.
model StudyConfig {
  id                 String   @id @default("global")
  /// Total hours a week you mean to study, across every module and free study. In minutes.
  weeklyGoalMinutes  Int?
  /// Flashcards: new cards introduced a day, and reviews a day at most.
  flashNewPerDay     Int      @default(20)
  flashReviewsPerDay Int      @default(200)
  updatedAt          DateTime @updatedAt
}

/// One sitting of study. With a module, it trains that module's stats; without one, three stats
/// rolled at random — for one-off work not worth making a module for.
model StudySession {
  id          String    @id @default(cuid())
  /// Local calendar date it belongs to, so it lands in the right day/week/month totals.
  date        DateTime  @db.Date
  moduleId    String?
  /// SetNull, not Cascade: deleting a module must not erase the hours already studied under it.
  module      Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  /// The module's name when the session ran. Kept because SetNull would otherwise leave a
  /// deleted module's sessions looking exactly like free ones. Null means it really was free.
  moduleTitle String?
  /// The stats this session pays, fixed when it starts. A snapshot, not a lookup: re-pointing a
  /// module's stats later must not rewrite what past sessions earned.
  stats       Stat[]
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  /// Filled in when the session ends.
  seconds     Int?
  createdAt   DateTime  @default(now())
  xpAwards    XpAward[]

  @@index([date])
  @@index([moduleId])
}

enum Stat {
  STRENGTH
  DEXTERITY
  CONSTITUTION
  INTELLIGENCE
  WISDOM
  CHARISMA
  RESOLVE
  INTUITION
  COMPOSURE
  WILLPOWER
  ESSENCE
  LOGIC
  RESONANCE
  MAGIC
}

// ─── AP COURSES ──────────────────────────────────────────────────────────────

/// A College Board AP course you are taking. Units are seeded from the official Course and Exam
/// Description; the tracker only records which of them you have finished.
model ApCourse {
  id        String   @id @default(cuid())
  /// Full official name, e.g. "AP Physics C: Mechanics".
  name      String   @unique
  /// Short label for tight spaces, e.g. "Physics C: Mech".
  shortName String
  /// Courses College Board treats as one continuous sequence share a series, and the tracker
  /// shows them together. Physics C is the case: Mechanics is units 1-7 and E&M is units 8-13,
  /// two separate exams numbered as one course framework.
  series    String?
  /// Display order across the tracker.
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     ApUnit[]

  @@index([position])
}

model ApUnit {
  id          String    @id @default(cuid())
  courseId    String
  course      ApCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Unit number as College Board numbers it.
  number      Int
  title       String
  /// Exam weighting as printed in the CED, e.g. "10-13%". Free text: the format varies by course
  /// and some units are not weighted at all.
  weighting   String?
  /// When you ticked it off. Null means not finished — the tick is the timestamp.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([courseId, number])
  @@index([courseId])
}

// ─── STUDY: PLANNER ──────────────────────────────────────────────────────────

/// A course or study area. Separate from the category: Mathematics can be Exam Preparation.
model StudySubject {
  id        String      @id @default(cuid())
  name      String      @unique
  /// A palette key from lib/study-tasks.ts (sky, cyan, …). Null draws the neutral chip.
  color     String?
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tasks     StudyTask[]
}

/// The kind of work — Homework, Exam Preparation — not the course. Defaults are seeded by
/// migration 039; ones you add are the same shape and can be renamed or removed.
model StudyCategory {
  id        String      @id @default(cuid())
  name      String      @unique
  color     String?
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tasks     StudyTask[]
}

/// One thing to study. A missing due date is a real task, not an unfinished form: it lives in
/// No date and is never overdue. Dates are Istanbul calendar days, stored as Postgres `date`.
model StudyTask {
  id          String            @id @default(cuid())
  title       String
  description String?
  subjectId   String?
  subject     StudySubject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    StudyCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dueDate     DateTime?         @db.Date
  /// "HH:MM", 24-hour, only meaningful with a due date. Compared to Europe/Istanbul.
  dueTime     String?
  priority    StudyTaskPriority @default(MEDIUM)
  status      StudyTaskStatus   @default(NOT_STARTED)
  tags        String[]          @default([])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Set when the status becomes Completed, cleared when it leaves. Not chosen by hand.
  completedAt DateTime?
  subtasks    StudySubtask[]

  @@index([dueDate])
  @@index([status])
  @@index([subjectId])
  @@index([categoryId])
}

model StudySubtask {
  id        String    @id @default(cuid())
  taskId    String
  task      StudyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean   @default(false)
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([taskId])
}

enum StudyTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum StudyTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── STUDY: SAT VOCABULARY ───────────────────────────────────────────────────

model VocabWord {
  id        String         @id @default(cuid())
  word      String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  meanings  VocabMeaning[]
  card      VocabCard?

  @@index([word])
}

/// One sense of a word. A word with three senses produces three questions, each asking about
/// one of them.
model VocabMeaning {
  id        String          @id @default(cuid())
  wordId    String
  word      VocabWord       @relation(fields: [wordId], references: [id], onDelete: Cascade)
  text      String
  /// 1, 2, 3 … within the word, so the list keeps the order it was imported in.
  position  Int
  createdAt DateTime        @default(now())
  questions VocabQuestion[]

  @@unique([wordId, position])
  @@index([wordId])
}

/// One sitting of the test. Starting a new full run is what resets the three categories: they
/// are just the verdicts on the current full run's questions. A quick test is a run too, but
/// never the current one — it leaves the full test and its categories alone.
model VocabRun {
  id         String          @id @default(cuid())
  kind       VocabRunKind    @default(FULL)
  /// For a quick test: the pool its questions came from ("all", "to_review", …).
  pool       String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  questions  VocabQuestion[]

  @@index([startedAt])
  @@index([kind, startedAt])
}

enum VocabRunKind {
  FULL
  QUICK
}

model VocabQuestion {
  id         String        @id @default(cuid())
  runId      String
  run        VocabRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The meaning being asked about — the correct answer.
  meaningId  String
  meaning    VocabMeaning  @relation(fields: [meaningId], references: [id], onDelete: Cascade)
  /// Order within the run. Fixed at generation so refreshing mid-test does not reshuffle.
  position   Int
  /// The four options as meaning ids, already shuffled, the correct one among them. Never holds
  /// another meaning of the same word — that would be a second correct answer.
  optionIds  String[]
  /// What was picked. Null until answered.
  chosenId   String?
  verdict    VocabVerdict?
  answeredAt DateTime?

  @@unique([runId, position])
  @@index([runId])
  @@index([meaningId])
}

enum VocabVerdict {
  DONE
  AMBIGUOUS
  TO_REVIEW
}

// ─── STUDY: FLASHCARDS ───────────────────────────────────────────────────────

/// A word's flashcard: the word on the front, its meanings on the back, scheduled like Anki
/// (lib/flashcards.ts). Made for every word the first time the flashcards are opened.
model VocabCard {
  id             String         @id @default(cuid())
  wordId         String         @unique
  word           VocabWord      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  state          VocabCardState @default(NEW)
  /// Which learning (or relearning) step it is on.
  step           Int            @default(0)
  /// Days until the next review, once it has graduated.
  interval       Int            @default(0)
  /// How much the interval grows on Good — 2.5 to start, lower each time it is forgotten.
  ease           Float          @default(2.5)
  due            DateTime       @default(now())
  reps           Int            @default(0)
  lapses         Int            @default(0)
  /// The order new cards are introduced in — random, fixed when the card is made.
  newOrder       Int            @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  reviews        VocabReview[]

  @@index([state, due])
}

enum VocabCardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// One answer to a flashcard. Counts today's new cards and reviews against the daily limits, and
/// holds the card as it was before, so the last answer can be undone.
model VocabReview {
  id          String         @id @default(cuid())
  cardId      String
  card        VocabCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// 1 Again, 2 Hard, 3 Good, 4 Easy.
  rating      Int
  /// The card's state before this answer — NEW marks a card introduced.
  stateBefore VocabCardState
  /// The card's scheduling fields before this answer, to undo it.
  before      Json
  reviewedAt  DateTime       @default(now())

  @@index([reviewedAt])
  @@index([cardId])
}

// ─── STUDY: GPA ──────────────────────────────────────────────────────────────

/// One lesson on the GPA sheet. Weekly hours weight it in each half that has a mark.
/// Averages are not stored — lib/gpa.ts works them out from the marks.
model GpaLesson {
  id       String @id @default(cuid())
  name     String
  /// Weekly hours of the lesson.
  hours    Float
  position Int
  /// First half of the year. Null is an empty cell, not a zero.
  h1Exam1   Float?
  h1Perf1   Float?
  h1Exam2   Float?
  h1Perf2   Float?
  h1Project Float?
  /// Second half of the year.
  h2Exam1   Float?
  h2Perf1   Float?
  h2Exam2   Float?
  h2Perf2   Float?
  h2Project Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// One answer to a SAT Question Bank question. The questions themselves stay at College Board
/// (lib/sat-qbank-service.ts); only what you answered is kept, so the bank can show what you
/// have done and what you got wrong.
model SatAttempt {
  id         String   @id @default(cuid())
  /// College Board's short question id.
  questionId String
  /// "rw" or "math".
  section    String
  domain     String
  skill      String
  difficulty String?
  /// The letter picked, or what was typed. Null when the question was left blank.
  answer     String?
  /// Null when the bank had no key for the question.
  correct    Boolean?
  /// Time spent on the question, in seconds.
  seconds    Int?
  createdAt  DateTime @default(now())

  @@index([questionId])
  @@index([createdAt])
}

/// A UCAT practice-test result, typed in by hand. The tests themselves are on the official UCAT
/// site; only the scores are kept here.
model UcatScore {
  id        String   @id @default(cuid())
  takenOn   DateTime @db.Date
  /// Which practice test: "Official Practice Test A", a question bank set…
  source    String
  /// Verbal Reasoning, Decision Making, Quantitative Reasoning: 300–900, null when not taken.
  vr        Int?
  dm        Int?
  qr        Int?
  /// Situational Judgement band, 1 (best) to 4.
  sjt       Int?
  notes     String?
  createdAt DateTime @default(now())

  @@index([takenOn])
}

/// A UCAT lesson the owner has finished. lessonId is "vr/how-it-works" — the lessons themselves are
/// code, in lib/ucat-content.
model UcatLessonDone {
  lessonId    String   @id
  completedAt DateTime @default(now())
}
